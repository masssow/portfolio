{% extends 'base.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ ('services2.cards.' ~ yaml_key ~ '.title')|trans }} — MassGrafik{% endblock %}
{% block meta_description %}{{ ('services2.cards.' ~ yaml_key ~ '.desc')|trans }}{% endblock %}

{% block schema_org %}
{{ parent() }}
{% set serviceSchema = {'@context':'https://schema.org','@type':'Service','name':('services2.cards.' ~ yaml_key ~ '.title')|trans,'description':('services2.cards.' ~ yaml_key ~ '.desc')|trans,'provider':{'@id':personId},'areaServed':['France','Spain'],'url':canonical} %}
<script type="application/ld+json">{{ serviceSchema|json_encode(15)|raw }}</script>
{% endblock %}

{% block body %}

{# Map slug → image (ajouter le nom de fichier quand l'image est prête) #}
{% set svc_images = {
  'e-commerce':      'massgrafik-commerce-composite.png',
  'sites-web':       null,
  'outils-gestion':  'visuel_outil_mg-intervention.png',
  'reservations':    null,
  'seo-contenu':     null,
  'automatisations': null,
  'maintenance':     null
} %}
{% set svc_image = svc_images[slug] ?? null %}

{# ===== BANNER ===== #}
<section class="banner_area">
  <div class="banner_inner d-flex align-items-center">
    <div class="container">
      <div class="banner_content text-center">
        <h1>{{ ('services2.cards.' ~ yaml_key ~ '.title')|trans }}</h1>
        <div class="page_link">
          <a href="{{ path('app_home',     {'_locale': app.request.locale}) }}">{{ 'menu.home'|trans }}</a>
          <a href="{{ path('app_services', {'_locale': app.request.locale}) }}">{{ 'menu.services'|trans }}</a>
          <a href="#">{{ ('services2.cards.' ~ yaml_key ~ '.title')|trans }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

{# ===== HERO SERVICE ===== #}
<section class="about_area section_gap">
  <div class="container">
    <div class="row align-items-center">

      {# Colonne gauche — accroche + CTA #}
      <div class="col-lg-5 mb-5 mb-lg-0">
        <span class="mg-offer-card__badge mg-offer-card__badge--{{ color }} mb-4 d-inline-block">
          {{ ('services2.cards.' ~ yaml_key ~ '.teaser')|trans }}
        </span>
        <div class="main_title text-left">
          <h2>{{ ('services2.cards.' ~ yaml_key ~ '.title')|trans }}</h2>
          <p>{{ ('services2.cards.' ~ yaml_key ~ '.intro')|trans }}</p>
        </div>
        <a class="primary_btn mt-3"
           href="{{ path('app_quote', {'_locale': app.request.locale, 'service': slug}) }}">
          <span>{{ 'cta.devis'|trans }}</span>
        </a>
        <a class="primary_btn tr-bg mt-3 ml-2"
           href="{{ path('app_tarifs', {'_locale': app.request.locale}) }}">
          <span>{{ 'menu.tarifs'|trans }}</span>
        </a>
      </div>

      {# Existing tool visual, or a concrete usage example. #}
      <div class="col-lg-6 offset-lg-1">
        {% if svc_image %}
          <figure class="img-ph img-ph--service">
            <img src="{{ asset('build/images/' ~ svc_image) }}"
                 alt="{{ ('services2.cards.' ~ yaml_key ~ '.title')|trans }} — MassGrafik"
                 class="img-ph__img"
                 loading="lazy">
          </figure>
        {% else %}
          <aside class="mg-example-panel">
            <span class="main_title__eyebrow">{{ 'services2.example_title'|trans }}</span>
            <p>{{ ('services2.cards.' ~ yaml_key ~ '.example')|trans }}</p>
          </aside>
        {% endif %}
      </div>

    </div>
  </div>
</section>

<section class="container pb-4"><h2 class="h4">{{ 'services2.audience_title'|trans }}</h2><p>{{ ('services2.cards.' ~ yaml_key ~ '.audience')|trans }}</p><p>{{ 'services2.scope'|trans }}</p></section>

{# ===== CE QUI EST INCLUS ===== #}
<section class="features_area section_gap" style="background:#f9f9ff;">
  <div class="container">
    <div class="row justify-content-center mb-4">
      <div class="col-lg-8 text-center">
        <div class="main_title">
          <h2>{{ 'services2.includes.title'|trans }}</h2>
        </div>
      </div>
    </div>
    <div class="row justify-content-center">
      {% for i in 1..6 %}
        {% set itemKey = 'services2.cards.' ~ yaml_key ~ '.items.' ~ i %}
        {% if (itemKey|trans) != itemKey %}
          <div class="col-lg-5 col-md-6 mb-3">
            <div class="svc-includes__item">
              <span class="svc-includes__check svc-check--{{ color }}" aria-hidden="true">✓</span>
              <span>{{ itemKey|trans }}</span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% include 'partials/_method.html.twig' %}

{# ===== CTA FINAL ===== #}
<section class="cta-final-section">
  <div class="container text-center">
    <div class="main_title">
      <h2>{{ 'cta.talk'|trans }}</h2>
      <p>{{ 'services2.cta.subtitle'|trans }}</p>
    </div>
    <a class="primary_btn"
       href="{{ path('app_quote', {'_locale': app.request.locale, 'service': slug}) }}">
      <span>{{ 'cta.devis'|trans }}</span>
    </a>
  </div>
</section>

{# ===== AUTRES SERVICES ===== #}
<section class="features_area section_gap bg-light-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8 text-center">
        <div class="main_title">
          <h2>{{ 'services2.others.title'|trans }}</h2>
        </div>
      </div>
    </div>
    <div class="row feature_inner justify-content-center">
      {% for svcSlug, svc in others|slice(0, 4) %}
        <div class="col-lg-3 col-md-6 mb-4">
          <a href="{{ path('app_service_detail', {'_locale': app.request.locale, 'slug': svcSlug}) }}"
             class="feature_item text-center feature_item--{{ svc.color }} feature_item--link">
            <span class="mg-offer-card__badge mg-offer-card__badge--{{ svc.color }} mb-3 d-inline-block">
              {{ ('services2.cards.' ~ svc.key ~ '.teaser')|trans }}
            </span>
            <h4>{{ ('services2.cards.' ~ svc.key ~ '.title')|trans }}</h4>
          </a>
        </div>
      {% endfor %}
    </div>
    <div class="row justify-content-center mt-2">
      <div class="col-auto">
        <a class="primary_btn tr-bg"
           href="{{ path('app_services', {'_locale': app.request.locale}) }}">
          <span>{{ 'services2.others.all'|trans }}</span>
        </a>
      </div>
    </div>
  </div>
</section>

{% endblock %}
