<!DOCTYPE html>
<html lang="{{ locale }}">
<head><meta charset="UTF-8"><title>{{ 'email.subject'|trans({}, 'messages', locale) }}</title></head>
<body style="font-family:Arial,sans-serif;line-height:1.7;color:#1e2d3e;background:#f5f8fc;padding:24px">
  <div style="max-width:600px;margin:auto;background:white;padding:32px">
    <p><strong>Massgrafik · Samba Sow</strong></p>
    <h1 style="font-size:24px">{{ 'email.greeting'|trans({'%name%':quote.name}, 'messages', locale) }}</h1>
    <p>{{ 'email.intro'|trans({}, 'messages', locale) }}</p>
    {% if choice_key %}<p><strong>{{ 'email.need'|trans({}, 'messages', locale) }} :</strong> {{ choice_key|trans({}, 'messages', locale) }}</p>{% endif %}
    <h2 style="font-size:18px">{{ 'email.summary'|trans({}, 'messages', locale) }}</h2>
    <p>{{ quote.message|nl2br }}</p>
    <p>{{ 'email.signature'|trans({}, 'messages', locale) }}<br><a href="mailto:contact.massgrafik@gmail.com">contact.massgrafik@gmail.com</a></p>
    <p style="font-size:12px">{{ 'email.privacy'|trans({}, 'messages', locale) }}</p>
  </div>
</body>
</html>
