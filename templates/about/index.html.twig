{% extends 'base.html.twig' %}
{% block title %}{{ 'about.seo.titleTab'|trans }}{% endblock %}
{% block meta_description %}{{ 'about.seo.metaDesc'|trans }}{% endblock %}
{% block body %}
<section class="banner_area"><div class="banner_inner d-flex align-items-center"><div class="container banner_content text-center"><h1>{{ 'about.hero.title'|trans }}</h1><p>{{ 'about.hero.subtitle'|trans }}</p></div></div></section>
<section class="section_gap"><div class="container"><div class="row align-items-center"><div class="col-md-5"><figure class="mg-portrait"><img src="{{ asset('build/images/portrait-fondat-samba.png') }}" alt="{{ 'site.portrait'|trans }}" width="560" height="620"><figcaption>{{ 'site.role'|trans }}</figcaption></figure></div><div class="col-md-6 offset-md-1"><div class="main_title text-left"><h2>{{ 'about.philosophy.title'|trans }}</h2><p>{{ 'about.philosophy.text1'|trans }}</p><p>{{ 'about.philosophy.text2'|trans }}</p></div></div></div></div></section>
<section class="section_gap bg-light-section"><div class="container"><div class="main_title text-center"><h2>{{ 'about.values.title'|trans }}</h2></div><div class="row">{% for i in 1..4 %}<div class="col-lg-3 col-md-6 mb-4"><article class="feature_item"><i class="fa-solid {{ ('about.values.items.' ~ i ~ '.icon')|trans }} mg-value-icon" aria-hidden="true"></i><h3>{{ ('about.values.items.' ~ i ~ '.title')|trans }}</h3><p>{{ ('about.values.items.' ~ i ~ '.desc')|trans }}</p></article></div>{% endfor %}</div></div></section>
<section class="section_gap"><div class="container"><div class="row"><div class="col-lg-6"><div class="main_title text-left"><h2>{{ 'about.forwho.title'|trans }}</h2><p>{{ 'about.forwho.intro'|trans }}</p></div><ul class="forwho-list">{% for i in 1..6 %}<li>{{ ('about.forwho.items.' ~ i)|trans }}</li>{% endfor %}</ul></div><div class="col-lg-6"><div class="main_title text-left"><h2>{{ 'about.zones.title'|trans }}</h2><p>{{ 'about.zones.subtitle'|trans }}</p></div>{% for zone in ['paris','spain'] %}<h3>{{ ('about.zones.' ~ zone ~ '.title')|trans }}</h3><p>{{ ('about.zones.' ~ zone ~ '.desc')|trans }}</p>{% endfor %}</div></div></div></section>
{% include 'partials/_project_cta.html.twig' %}
{% endblock %}
