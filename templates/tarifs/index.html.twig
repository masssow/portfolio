{% extends 'base.html.twig' %}
{% block title %}{{ 'tarifs.seo.titleTab'|trans }}{% endblock %}
{% block meta_description %}{{ 'tarifs.seo.metaDesc'|trans }}{% endblock %}
{% block body %}
<section class="banner_area"><div class="banner_inner d-flex align-items-center"><div class="container banner_content text-center"><h1>{{ 'tarifs.hero.title'|trans }}</h1><p>{{ 'tarifs.hero.subtitle'|trans }}</p></div></div></section>
{% include 'partials/_offers.html.twig' %}
<section class="section_gap bg-light-section"><div class="container"><div class="main_title text-center"><h2>{{ 'tarifs.faq.title'|trans }}</h2></div><div class="mg-faq mx-auto">{% for i in 1..5 %}<details{% if i == 1 %} open{% endif %}><summary>{{ ('tarifs.faq.items.' ~ i ~ '.q')|trans }}</summary><p>{{ ('tarifs.faq.items.' ~ i ~ '.a')|trans }}</p></details>{% endfor %}</div></div></section>
{% include 'partials/_project_cta.html.twig' %}
{% endblock %}
