<!DOCTYPE html>
{% set locale = app.request.locale in ['fr', 'es'] ? app.request.locale : 'fr' %}
{% set currentRoute = app.request.attributes.get('_route') %}
{% set routeParams = app.request.attributes.get('_route_params')|default({}) %}
{% set bilingual = currentRoute in ['app_home', 'app_services', 'app_service_detail', 'app_about', 'app_tarifs', 'app_quote', 'app_quote_thanks', 'app_legal_mentions', 'app_legal_privacy', 'app_legal_cookies'] %}
{% set canonicalParams = routeParams %}
{% if currentRoute in ['app_posts','app_posts_by_categorie'] and app.request.query.getInt('page', 1) > 1 %}
  {% set canonicalParams = canonicalParams|merge({'page':app.request.query.getInt('page')}) %}
{% endif %}
{% set canonical = url(currentRoute, canonicalParams) %}
{% set personId = absolute_url(path('app_home', {'_locale': 'fr'})) ~ '#samba' %}
<html lang="{{ locale }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}{{ 'site.title'|trans }}{% endblock %}</title>
  <meta name="description" content="{% block meta_description %}{{ 'site.subtitle'|trans }}{% endblock %}">
  <link rel="canonical" href="{{ canonical }}">
  {% if bilingual %}
    {% for language in ['fr', 'es'] %}<link rel="alternate" hreflang="{{ language }}" href="{{ url(currentRoute, routeParams|merge({'_locale': language})) }}">{% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ url(currentRoute, routeParams|merge({'_locale': 'fr'})) }}">
  {% endif %}
  {% if currentRoute == 'app_quote_thanks' %}<meta name="robots" content="noindex, follow">{% endif %}
  <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
  <meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:type" content="{% block og_type %}website{% endblock %}">
  <meta property="og:locale" content="{{ locale == 'es' ? 'es_ES' : 'fr_FR' }}">
  <meta property="og:image" content="{{ absolute_url(asset('build/images/portrait%20pro-mass.png')) }}">
  <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
  <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">
  {% block stylesheets %}{{ encore_entry_link_tags('app') }}{% endblock %}
  {% block schema_org %}
    {% set schema = {'@context':'https://schema.org', '@graph':[
      {'@type':'Person', '@id':personId, 'name':'Samba Sow', 'jobTitle':('site.role'|trans), 'url':url('app_about', {'_locale':locale}), 'image':absolute_url(asset('build/images/portrait%20pro-mass.png')), 'email':'contact.massgrafik@gmail.com', 'sameAs':['https://www.linkedin.com/in/massgrafik-web'], 'knowsLanguage':['fr','es']},
      {'@type':'WebSite', '@id':absolute_url(path('app_home', {'_locale':'fr'})) ~ '#website', 'name':'Massgrafik', 'url':url('app_home', {'_locale':locale}), 'description':('site.subtitle'|trans), 'inLanguage':locale, 'publisher':{'@id':personId}}
    ]} %}
    <script type="application/ld+json">{{ schema|json_encode(15)|raw }}</script>
  {% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
<a class="skip-link" href="#main-content">{{ 'site.skip'|trans }}</a>
<header class="header_area">
  <div class="main_menu"><nav class="navbar navbar-expand-lg navbar-light" aria-label="{{ 'site.navigation'|trans }}"><div class="container">
    <a class="navbar-brand logo_h" href="{{ path('app_home', {'_locale':locale}) }}"><img src="{{ asset('build/images/logo-trans-re.png') }}" alt="Massgrafik" width="150" height="60"></a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="{{ 'site.menu_toggle'|trans }}"><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent"><ul class="nav navbar-nav menu_nav ml-auto">
      {% set navigation = {'home':'app_home','services':'app_services','tarifs':'app_tarifs','about':'app_about','blog':'app_posts','contact':'app_quote'} %}
      {% for label, route in navigation %}
        {% set active = currentRoute == route or (route == 'app_services' and currentRoute == 'app_service_detail') or (route == 'app_posts' and currentRoute in ['app_single_posts','app_posts_by_categorie']) %}
        <li class="nav-item{{ active ? ' active' : '' }}"><a class="nav-link" href="{{ path(route, route == 'app_posts' ? {} : {'_locale':locale}) }}"{% if active %} aria-current="page"{% endif %}>{{ ('menu.' ~ label)|trans }}</a></li>
      {% endfor %}
    </ul>
    <div class="nav-lang" aria-label="{{ 'site.languages'|trans }}">
      {% for language in ['fr','es'] %}
        <a class="nav-link{{ locale == language ? ' is-current' : '' }}" href="{{ bilingual ? path(currentRoute, routeParams|merge(app.request.query.all|filter((value, key) => key in ['pack', 'service']))|merge({'_locale':language})) : (language == 'fr' ? path(currentRoute, canonicalParams) : path('app_home', {'_locale':'es'})) }}" lang="{{ language }}" hreflang="{{ language }}"{% if locale == language %} aria-current="true"{% endif %}>{{ language|upper }}</a>
      {% endfor %}
    </div></div>
  </div></nav></div>
</header>
<main id="main-content">{% block body %}{% endblock %}</main>
<footer class="footer_area"><div class="container"><div class="row py-5">
  <div class="col-lg-4 mb-4"><a href="{{ path('app_home', {'_locale':locale}) }}"><img src="{{ asset('build/images/logo-trans-re.png') }}" alt="Massgrafik" width="150" height="60"></a><p class="mt-3"><strong>{{ 'site.role'|trans }}</strong></p><p>{{ 'site.subtitle'|trans }}</p><a href="https://www.linkedin.com/in/massgrafik-web" rel="noopener" target="_blank">LinkedIn</a></div>
  <div class="col-lg-2 col-sm-6 mb-4"><h2 class="footer-col-title">{{ 'site.navigation'|trans }}</h2><ul class="footer-links">{% for label, route in navigation %}<li><a href="{{ path(route, route == 'app_posts' ? {} : {'_locale':locale}) }}">{{ ('menu.' ~ label)|trans }}</a></li>{% endfor %}</ul></div>
  <div class="col-lg-3 col-sm-6 mb-4"><h2 class="footer-col-title">{{ 'cta.contact'|trans }}</h2><ul class="footer-links"><li><a href="tel:+33666117428">+33 6 66 11 74 28</a></li><li><a href="mailto:contact.massgrafik@gmail.com">contact.massgrafik@gmail.com</a></li></ul><p class="mt-3">{{ 'site.zone'|trans }}</p></div>
  <div class="col-lg-3 mb-4"><h2 class="footer-col-title">{{ 'site.legal'|trans }}</h2><ul class="footer-links">{% for label, route in {'mentions':'app_legal_mentions','privacy':'app_legal_privacy','cookies':'app_legal_cookies'} %}<li><a href="{{ path(route, {'_locale':locale}) }}">{{ ('site.' ~ label)|trans }}</a></li>{% endfor %}<li><button type="button" class="text-button" onclick="window.openCookieBanner?.()">{{ 'site.manage_cookies'|trans }}</button></li></ul></div>
</div><div class="footer_bottom text-center"><p>Massgrafik © {{ 'now'|date('Y') }} · {{ 'site.rights'|trans }}</p></div></div></footer>
<div class="mobile-sticky-cta d-lg-none"><a class="primary_btn w-100 text-center" href="{{ path('app_quote', {'_locale':locale}) }}">{{ 'cta.devis'|trans }}</a></div>
<div id="cookie-banner" class="cookie-banner" role="region" aria-label="{{ 'site.cookies'|trans }}" style="display:none"><div class="cookie-content"><p>{{ 'cookie.banner.text'|trans }} <a href="{{ path('app_legal_cookies', {'_locale':locale}) }}">{{ 'cookie.banner.more'|trans }}</a></p><div class="cookie-actions"><button id="cookie-accept" class="primary_btn" type="button">{{ 'cookie.banner.accept'|trans }}</button><button id="cookie-decline" class="primary_btn tr-bg" type="button">{{ 'cookie.banner.decline'|trans }}</button></div></div></div>
<a href="#main-content" id="scroll-top" aria-label="{{ 'site.top'|trans }}"><i class="fa-solid fa-chevron-up" aria-hidden="true"></i></a>
{% block javascripts %}{{ encore_entry_script_tags('app') }}{% endblock %}
</body>
</html>
