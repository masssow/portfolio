<article class="blog_item">
  <p class="small">Samba Sow · {{ post.createdAt|date('d/m/Y') }}</p>
  {% if post.imageName %}<img src="{{ asset('images/posts/' ~ post.imageName) }}" alt="{{ post.title }}" class="img-fluid" loading="lazy">{% endif %}
  <h2><a href="{{ path('app_single_posts', {'id':post.id}) }}">{{ post.title }}</a></h2>
  <p>{{ post.content|striptags|slice(0,150) }}…</p>
  <a class="primary_btn" href="{{ path('app_single_posts', {'id':post.id}) }}">Lire l’article</a>
</article>
