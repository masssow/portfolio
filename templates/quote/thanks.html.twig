{# templates/quote/thanks.html.twig #}
{% extends 'base.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ 'quote.seo.titleThanks'|trans }}{% endblock %}

{% block body %}
<section class="home_banner_area">
  <div class="banner_inner">
    <div class="container">
      <h1>{{ 'quote.thanks.title'|trans }}</h1>
      <p>{{ 'quote.thanks.desc'|trans }}</p>
      <a class="primary_btn" href="{{ path('app_home', {'_locale':app.request.locale}) }}"><span>{{ 'quote.thanks.back'|trans }}</span></a>
    </div>
  </div>
</section>
{% endblock %}
